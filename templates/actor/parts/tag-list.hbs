{{#if tags.length}}
  <div class="fu-tag-list">
    {{#each tags as |tag i|}}
      <div class="fu-tag-row">
        <input type="text" name="system.{{../list}}.{{i}}" value="{{tag}}" placeholder="{{../placeholder}}" />
        <button type="button" data-action="tag-delete" data-list="{{../list}}" data-index="{{i}}" title="Remove"><i class="fas fa-times"></i></button>
      </div>
    {{/each}}
  </div>
{{else}}
  <p class="fu-empty">—</p>
{{/if}}
